<resources>
    <!-- Android 12+ opening screen: the app icon on the wall colour, so opening the app looks like the app. -->
    <style name="Theme.StudioAgent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wall</item>
        <item name="android:colorBackground">@color/wall</item>
        <item name="android:windowSplashScreenBackground">@color/wall</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
    </style>
</resources>
